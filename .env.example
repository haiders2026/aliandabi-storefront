# WooCommerce / WordPress base URL (no trailing slash)
WC_BASE_URL=https://www.aliandabi.com
# Same URL exposed to the browser (checkout hand-off, account links)
NEXT_PUBLIC_WC_BASE_URL=https://www.aliandabi.com

# Public URL of this storefront (sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://shop.aliandabi.com

# Shared secret for the WooCommerce webhook that calls /api/revalidate
REVALIDATE_SECRET=change-me
